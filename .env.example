# Copy to .env and edit. Everything has a working default, so this file is
# optional: the project runs offline with no configuration at all.

# --- decision backend -------------------------------------------------------
# offline | openai | ollama
LLM_BACKEND=offline

# --- OpenAI-compatible endpoint (used when LLM_BACKEND=openai) --------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Ollama (used when LLM_BACKEND=ollama) ---------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=400
LLM_TIMEOUT=60

# --- simulation -------------------------------------------------------------
SEED=42
STEPS=60

# --- ACE playbook -----------------------------------------------------------
MAX_BULLETS=24
BULLET_TOKEN_BUDGET=600
DEDUP_THRESHOLD=0.82
CURATOR_EVERY=1
REFLECTOR_ROUNDS=1

# --- web server -------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
